rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.createdAt is number
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000000));
    }
    
    function isValidOrder(data) {
      return data.keys().hasAll(['total', 'status', 'date', 'items'])
        && data.total is number
        && data.status is string && data.status.size() <= 50
        && data.date is string && data.date.size() <= 50
        && data.items is list;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming());
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().createdAt == existing().createdAt;
                    
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(orderId)
                      && isValidOrder(incoming());
        allow update, delete: if false; // Orders shouldn't be mutated by client
        allow list: if isOwner(userId);
      }
    }
  }
}
